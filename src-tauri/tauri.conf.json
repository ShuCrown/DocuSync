{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicegram-tauri/dev/crates/tauri-utils/schema.json",
  "productName": "DocuSync",
  "version": "0.0.27",
  "identifier": "com.docusync.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DocuSync",
        "url": "index.html",
        "width": 1600,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#f5f4ed"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBQUJBNjAxNzQ3NTk0REYKUldUZmxIVjBBYWFyK2tQei92S3NYUCtCczdsemxyamkrRDJDVUIxNTVjWjZhNUNybEk4TnVyczkK",
      "endpoints": [
        "https://github.com/ShuCrown/DocuSync/releases/latest/download/latest.json"
      ]
    }
  }
}
