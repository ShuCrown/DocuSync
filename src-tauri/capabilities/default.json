{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main DocuSync window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "updater:default",
    "process:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$APPDATA/docusync" },
        { "path": "$APPDATA/docusync/**" }
      ]
    },
    "sql:default",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute",
    "sql:allow-close",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$APPDATA/docusync" },
        { "path": "$APPDATA/docusync/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$APPDATA/docusync" },
        { "path": "$APPDATA/docusync/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPDATA/docusync/**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPDATA/docusync/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPDATA/docusync/**" }]
    }
  ]
}
